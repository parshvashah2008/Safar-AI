# ==============================================================
# SAFAR AI — ENVIRONMENT CONFIGURATION
# Rename or copy this file to `.env.local` inside `safar-ai/`
# ==============================================================

# 1. Google Gemini AI Engine (Required for live itinerary generation & Copilot chat)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Google Cloud Translation API (For real-time multilingual translation)
# Get from: https://console.cloud.google.com/apis/library/translate.googleapis.com
GOOGLE_TRANSLATE_API_KEY=

# 3. Google Maps Platform (For live Google Maps JavaScript SDK)
# Get from: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 4. Supabase (Optional: For cloud database & authentication)
# Get from: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 5. Travel & Wallet Providers (Optional sandbox keys)
FLIGHT_PROVIDER_API_KEY=
WALLET_PROVIDER_API_KEY=
